":{"03e85247-cd80-488f-979e-f1c3590bcdff":{"sourceCode":"import { Input, Message } from \"./types.ts\";\n\n// Definujeme, jak bude vypadat náš výstup. \n// Potřebujeme jen jedno číslo pro tachometr.\ntype Output = {\n  speed: number;\n};\n\n// Zde doplň PŘESNÝ název tvého topicu s odometrií z bagu\nexport const inputs = [\"/uav80/estimation_manager/odom_main\"];\n\n// Takhle se bude jmenovat nový \"virtuální\" topic, který uvidíš ve Foxglove\nexport const output = \"/foxglove_script/speed\";\n\nexport default function script(event: Input<\"/uav80/estimation_manager/odom_main\">): Output {\n  // Přístup k datům ze zprávy (uprav cestu, pokud nepoužíváš nav_msgs/Odometry)\n  const linear = event.message.twist.twist.linear;\n\n  // Výpočet velikosti vektoru (normy) ve 3D prostoru\n  const speed = Math.sqrt(\n    Math.pow(linear.x, 2) + \n    Math.pow(linear.y, 2) + \n    Math.pow(linear.z, 2)\n  )*3.6;\n\n  // Vrácení výsledku\n  return {\n    speed: speed,\n  };\n};","name":"03e85247"}}},"savedAt":"2026-05-04T07:40:01.544Z"},"lastViewedAt":"2026-05-03T19:25:10.903Z","syncInfo":{"status":"tracked","lastRemoteSavedAt":"2026-05-04T07:40:01.544Z","lastRemoteUpdatedAt":"2026-05-04T07:40:03.611Z"}}