#!/usr/bin/env bash
# wallpaper – calm animated ASCII wallpaper: a kitty panel in the sway background layer.
#
#   wallpaper                start the saved mode (sway runs this at login)
#   wallpaper theme          the current theme's scenes: a different one on each monitor,
#                            moving on every $WALLPAPER_ROTATE minutes (default 30, 0 = never)
#   wallpaper <scene>        one scene everywhere (see `wallpaper list`)
#   wallpaper next           move on to the next scenes now (theme mode)
#   wallpaper static         plain background in the palette's colour
#   wallpaper list           scenes, the theme's ones and the active mode
#   wallpaper reload         re-read colours and the theme's scenes (called by `theme`)
#   wallpaper stop
#
# Scenes: bonsai (cbonsai), night, space, forest, aquarium, galaxy and its variants galaxy-ember,
# -nebula, -andromeda, -emerald, -whirlpool, -rainbow (ascii-scenes), asciiquarium,
# cmatrix, the ascii.rest scenes in ~/.local/share/ascii-pieces/pieces/ (ascii-pieces: coloured
# ASCII in their own colours, not the theme's, font $WALLPAPER_PIECES_FONT (12), ~5-10 % CPU
# per monitor), plus any executable in ~/.config/wallpaper/.
# Each palette lists its scenes in WALLPAPERS; `theme` writes them to ~/.config/themes/current-wallpapers.
# One kitty instance serves every output (more panels are added over its control
# socket); colours come from ~/.config/kitty/wallpaper.conf, generated by `theme`.
# Sway itself must not set `output * bg` – its swaybg would cover the panel.
set -euo pipefail

KITTY="$HOME/.local/kitty.app/bin/kitty"
CONF="$HOME/.config/kitty/wallpaper.conf"
THEMES="$HOME/.config/themes"
MODE_FILE="$THEMES/wallpaper"
THEME_SCENES="$THEMES/current-wallpapers"
CUSTOM="$HOME/.config/wallpaper"
PIECES="$HOME/.local/share/ascii-pieces/pieces"   # ascii.rest scenes, played by ascii-pieces
RUN="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
SOCK="$RUN/kitty-wallpaper.sock"     # kitty remote control (kitty appends -<pid>), adds panels
ROTATE=${WALLPAPER_ROTATE:-30}
PIECES_FONT=${WALLPAPER_PIECES_FONT:-12}   # smaller font for the ascii.rest scenes: more characters, more detail
SCENES_PY=$("$HOME/.local/bin/ascii-scenes" list 2>/dev/null | tr '\n' ' ')   # night space ... galaxy galaxy-<variant>
BUILTIN="bonsai ${SCENES_PY}asciiquarium cmatrix"

die() { echo "wallpaper: $*" >&2; exit 1; }

mode() { cat "$MODE_FILE" 2>/dev/null || echo theme; }

# light palette = wallpaper background brighter than 50 %
light() {
  local bg; bg=$(sed -n 's/^background *#//p' "$CONF")
  (( (299 * 0x${bg:0:2} + 587 * 0x${bg:2:2} + 114 * 0x${bg:4:2}) / 1000 > 128 ))
}

cmd_for() {
  local env=""; light && env="env SCENE_LIGHT=1 "
  case $1 in
    bonsai|cbonsai) echo "cbonsai --live --infinite --time=0.08 --wait=8 --base=1" ;;
    asciiquarium) echo "$HOME/.local/bin/asciiquarium" ;;
    cmatrix)      echo "cmatrix -b -u 8" ;;
    *)            if [[ " $SCENES_PY " == *" $1 "* ]]; then echo "${env}$HOME/.local/bin/ascii-scenes $1"
                  elif [[ -f $PIECES/$1.ts ]]; then echo "$HOME/.local/bin/ascii-pieces $1"
                  elif [[ -x $CUSTOM/$1 && ! -d $CUSTOM/$1 ]]; then echo "$CUSTOM/$1"
                  else return 1; fi ;;
  esac
}

# every helper runs in its own process group (setsid), so kill the whole group
kill_pidfile() {
  local f="$RUN/wallpaper-$1.pid"
  [[ -f $f ]] && kill -- "-$(cat "$f")" 2>/dev/null || true
  rm -f "$f"
}

active_outputs() { swaymsg -t get_outputs | jq -r '[.[] | select(.active) | .name] | sort | join(" ")'; }

stop_panels() {
  kill_pidfile kitty
  rm -f "$SOCK"-*
  kill_pidfile swaybg
}

# scene for the k-th output: theme mode walks the theme's list, shifted by the rotation
scene_for() {
  local mode=$1 k=$2 idx
  if [[ $mode != theme ]]; then echo "$mode"; return; fi
  local -a list=()
  [[ -f $THEME_SCENES ]] && read -ra list < "$THEME_SCENES"
  (( ${#list[@]} )) || list=(bonsai)
  idx=$(cat "$RUN/wallpaper-index" 2>/dev/null || echo 0)
  echo "${list[(idx + k) % ${#list[@]}]}"
}

start_panels() {
  local mode=$1 outputs o k=0 cmd pid sock=""
  outputs=$(active_outputs)
  echo "$outputs" > "$RUN/wallpaper-outputs"
  if [[ $mode == static ]]; then
    setsid swaybg -o '*' -c "$(sed -n 's/^background *//p' "$CONF")" >/dev/null 2>&1 &
    echo $! > "$RUN/wallpaper-swaybg.pid"
    return
  fi
  # the font belongs to the one kitty instance: small when its first scene is an ascii.rest one
  local font=()
  [[ -f $PIECES/$(scene_for "$mode" 0).ts ]] && font=(-o "font_size=$PIECES_FONT")
  for o in $outputs; do
    cmd=$(cmd_for "$(scene_for "$mode" $k)") || cmd=$(cmd_for bonsai)
    if (( k == 0 )); then
      # shellcheck disable=SC2086
      setsid "$KITTY" +kitten panel --edge=background --output-name="$o" --config="$CONF" "${font[@]}" \
        -o allow_remote_control=socket-only -o listen_on="unix:$SOCK" \
        $cmd >>"$RUN/wallpaper.log" 2>&1 &
      pid=$!
      echo $pid > "$RUN/wallpaper-kitty.pid"
      sock="$SOCK-$pid"
      for _ in {1..50}; do [[ -S $sock ]] && break; sleep 0.1; done
    else
      # shellcheck disable=SC2086
      "$KITTY" @ --to "unix:$sock" launch --type=os-panel --os-panel edge=background \
        --os-panel output-name="$o" $cmd >>"$RUN/wallpaper.log" 2>&1 || true
    fi
    k=$((k + 1))
  done
}

restart() { stop_panels; start_panels "$(mode)"; }

start_helpers() {
  kill_pidfile watch
  setsid "$0" _watch >/dev/null 2>&1 &
  echo $! > "$RUN/wallpaper-watch.pid"
  kill_pidfile rotate
  if [[ $(mode) == theme ]] && (( ROTATE > 0 )); then
    setsid "$0" _rotate >/dev/null 2>&1 &
    echo $! > "$RUN/wallpaper-rotate.pid"
  fi
}

advance() {
  local idx; idx=$(cat "$RUN/wallpaper-index" 2>/dev/null || echo 0)
  echo $((idx + 1)) > "$RUN/wallpaper-index"
}

[[ -x $KITTY ]] || die "kitty not found at $KITTY"
[[ -f $CONF ]] || die "$CONF missing – run: theme reapply"

case "${1:-}" in
  "")
    new=$(mode) ;;
  stop)
    kill_pidfile watch; kill_pidfile rotate; stop_panels; exit ;;
  next)
    advance; restart; exit ;;
  reload)
    case $(mode) in
      theme|static) restart ;;                         # scenes or colour may have changed
      *) f="$RUN/wallpaper-kitty.pid"                  # kitty reloads its config on USR1
         [[ -f $f ]] && kill -USR1 "$(cat "$f")" 2>/dev/null || true ;;
    esac
    exit ;;
  list)
    cur=$(mode)
    printf '%s %-13s %s\n' "$([[ $cur == theme ]] && echo '*' || echo ' ')" theme \
      "($(cat "$THEME_SCENES" 2>/dev/null || echo bonsai))"
    for m in $BUILTIN static $(find "$PIECES" -maxdepth 1 -name '*.ts' -printf '%f\n' 2>/dev/null | sed 's/\.ts$//' | sort) \
             $(find "$CUSTOM" -maxdepth 1 -type f -executable -printf '%f\n' 2>/dev/null | sort); do
      printf '%s %s\n' "$([[ $m == "$cur" ]] && echo '*' || echo ' ')" "$m"
    done
    exit ;;
  _watch)        # re-create the panels when the set of outputs changes (monitor plugged
                 # in/out); `swaymsg reload` also sends output events, hence the comparison
    swaymsg -m -t subscribe '["output"]' | while read -r _; do
      while read -r -t 1 _; do :; done               # debounce bursts of events
      [[ $(active_outputs) == "$(cat "$RUN/wallpaper-outputs" 2>/dev/null)" ]] && continue
      restart
    done
    exit ;;
  _rotate)
    while sleep $((ROTATE * 60)); do advance; restart; done
    exit ;;
  -h|--help)
    sed -n '2,/^set -euo/{/^#/s/^# \{0,1\}//p}' "$0"; exit ;;
  *)
    [[ $1 == theme || $1 == static ]] || cmd_for "$1" >/dev/null || die "unknown mode '$1' (see: wallpaper list)"
    new=$1 ;;
esac

echo "$new" > "$MODE_FILE"
restart
start_helpers
