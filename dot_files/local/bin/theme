#!/usr/bin/env bash
# theme – one colour palette for sway, waybar, tmux, foot, wofi, zsh/p10k, yazi and nvim.
#
#   theme               show the active palette
#   theme list          list palettes (* = active)
#   theme <name>        apply ~/.config/themes/palettes/<name>.sh and reload everything
#   theme toggle        switch between <name> and <name>-light
#   theme reapply       regenerate files from the active palette (after editing it)
#   theme yazi-icons    re-extract yazi's built-in icon glyphs (after a yazi upgrade)
#
# Palette roles are documented in palettes/steel.sh. Generated files (do not edit):
#   ~/.config/waybar/theme.css  ~/.config/sway/theme.conf  ~/.config/tmux/theme.conf
#   ~/.config/foot/colors.ini   ~/.config/wofi/style.css    ~/.config/zsh/theme.zsh
#   ~/.config/yazi/theme.toml   ~/.config/nvim/lua/theme_colors.lua
#   ~/.config/kitty/wallpaper.conf (animated wallpaper, see `wallpaper`)
set -euo pipefail

THEMES="$HOME/.config/themes"
PALETTES="$THEMES/palettes"
CURRENT_FILE="$THEMES/current"

die() { echo "theme: $*" >&2; exit 1; }

# Icon glyphs of yazi's built-in preset, pulled from the binary so `theme` can recolour
# them (the preset has fixed devicons colours that theme.toml can only replace wholesale).
YAZI_ICONS="$THEMES/yazi-icons.txt"
extract_yazi_icons() {
  local bin; bin=$(command -v yazi) || die "yazi not found"
  python3 -I - "$bin" "$YAZI_ICONS" <<'PY' || die "could not extract yazi icons"
import re, sys
data = open(sys.argv[1], 'rb').read()
start = data.find(b'dirs  = [\n')
end = data.find(b'\n]', data.find(b'\nconds = [', start) + 1)
txt = data[start:end + 2].decode('utf8')
with open(sys.argv[2], 'w') as f:
    f.write('# v2 yazi built-in icon glyphs (name<TAB>glyph<TAB>original colour), from `theme yazi-icons`\n')
    for sec, key in (('dirs', 'name'), ('files', 'name'), ('exts', 'name'), ('conds', 'if')):
        body = re.search(r'^' + sec + r'\s*= \[\n(.*?)^\]', txt, re.S | re.M).group(1)
        ents = re.findall(r'\{ ' + key + r' = "((?:[^"\\]|\\.)*)", text = "([^"]*)", fg = "(#[0-9a-fA-F]{6})" \}', body)
        if not ents: sys.exit(f'no {sec} entries found')
        f.write(f'[{sec}]\n' + ''.join(f'{n}\t{t}\t{c}\n' for n, t, c in ents))
PY
}
current() { cat "$CURRENT_FILE" 2>/dev/null || echo steel; }

case "${1:-}" in
  "")
    current; exit ;;
  list)
    cur=$(current)
    for f in "$PALETTES"/*.sh; do
      n=$(basename "$f" .sh)
      desc=$(sed -n '1s/^# *//p' "$f")
      printf '%s %-18s %s\n' "$([[ $n == "$cur" ]] && echo '*' || echo ' ')" "$n" "$desc"
    done
    exit ;;
  toggle)
    cur=$(current)
    if [[ $cur == *-light ]]; then name=${cur%-light}
    else name=$cur-light; fi
    [[ -f $PALETTES/$name.sh ]] || die "no light/dark pair for '$cur' (missing $name.sh)" ;;
  reapply)
    name=$(current) ;;
  yazi-icons)
    extract_yazi_icons; echo "theme: $(grep -vc '^[#[]' "$YAZI_ICONS") yazi icons in $YAZI_ICONS"
    name=$(current) ;;
  -h|--help)
    sed -n '2,13s/^# \{0,1\}//p' "$0"; exit ;;
  *)
    name=$1 ;;
esac

palette="$PALETTES/$name.sh"
[[ -f $palette ]] || die "unknown palette '$name' (see: theme list)"

# ─── Load palette ────────────────────────────────────────────────────────────
ANSI=() HUES=() WALLPAPERS=()
# shellcheck source=/dev/null
source "$palette"
yazi_flavor=${YAZI_FLAVOR:-}
: "${ACCENT_FG:=$UI_FG}" "${URGENT:=#ff6e6e}" "${URGENT_FG:=#21222c}"
: "${WARN:=#ffffa5}" "${WARN_FG:=#21222c}" "${MENU_BG:=$TERM_BG}" "${MENU_FG:=$TERM_FG}"
: "${UI_BG2:=$UI_BG}" "${CMD_FG:=$UI_BG}" "${NVIM_NATIVE:=0}" "${TERM_ALPHA:=0.90}"
[[ $TERM_ALPHA =~ ^(0(\.[0-9]+)?|1(\.0+)?)$ ]] || die "$name: TERM_ALPHA='$TERM_ALPHA' is not 0..1"
# translucent terminal: apps that paint their own background (nvim, yazi) switch it off
translucent=0; [[ $TERM_ALPHA =~ ^1(\.0+)?$ ]] || translucent=1

for v in UI_BG UI_BG2 UI_FG ACCENT ACCENT_FG FADE URGENT URGENT_FG WARN WARN_FG \
         TERM_BG TERM_FG MENU_BG MENU_FG CMD_FG; do
  [[ ${!v:-} =~ ^#[0-9a-fA-F]{6}$ ]] || die "$name: $v='${!v:-}' is not #rrggbb"
done
(( ${#ANSI[@]} == 0 || ${#ANSI[@]} == 16 )) || die "$name: ANSI needs 16 colours, has ${#ANSI[@]}"
for c in "${ANSI[@]}"; do [[ $c =~ ^#[0-9a-fA-F]{6}$ ]] || die "$name: bad ANSI colour '$c'"; done

header="generated by 'theme $name' – edit $palette instead"

# mix <#a> <#b> <percent of b>
mix() {
  local a=$1 b=$2 t=$3 out="#" i
  for i in 1 3 5; do
    out+=$(printf '%02x' $(( (0x${a:i:2} * (100 - t) + 0x${b:i:2} * t) / 100 )))
  done
  echo "$out"
}
# light palette = terminal background brighter than 50 %
is_light() { (( (299 * 0x${TERM_BG:1:2} + 587 * 0x${TERM_BG:3:2} + 114 * 0x${TERM_BG:5:2}) / 1000 > 128 )); }

# HUES: red orange yellow green cyan blue magenta
if (( ! ${#HUES[@]} )); then
  if (( ${#ANSI[@]} )); then
    HUES=("${ANSI[9]}" "$(mix "${ANSI[9]}" "${ANSI[11]}" 50)" "${ANSI[11]}" "${ANSI[10]}" "${ANSI[14]}" "${ANSI[12]}" "${ANSI[13]}")
  else
    HUES=("#f38ba8" "#fab387" "#f9e2af" "#a6e3a1" "#94e2d5" "#89b4fa" "#cba6f7")
  fi
fi
(( ${#HUES[@]} == 7 )) || die "$name: HUES needs 7 colours, has ${#HUES[@]}"
for c in "${HUES[@]}"; do [[ $c =~ ^#[0-9a-fA-F]{6}$ ]] || die "$name: bad HUES colour '$c'"; done
H_RED=${HUES[0]} H_ORANGE=${HUES[1]} H_YELLOW=${HUES[2]} H_GREEN=${HUES[3]}
H_CYAN=${HUES[4]} H_BLUE=${HUES[5]} H_MAGENTA=${HUES[6]}

# a fresh machine may not have every config dir yet
mkdir -p "$HOME"/.config/{waybar,sway,tmux,foot,wofi,zsh,yazi,nvim/lua,kitty}

# ─── waybar ──────────────────────────────────────────────────────────────────
cat > "$HOME/.config/waybar/theme.css" <<EOF
/* $header */
@define-color foreground1 $UI_FG;
@define-color foreground2 $ACCENT;
@define-color accent_fg $ACCENT_FG;
@define-color background $UI_BG;
@define-color fade $FADE;
@define-color battery_discharge $UI_FG;
@define-color brred $URGENT;
@define-color bryellow $WARN;
@define-color orange #ffb86c;
@define-color gray #44475a;
@define-color black #21222c;
@define-color red #ff5555;
@define-color green #50fa7b;
@define-color yellow #f1fa8c;
@define-color cyan #8be9fd;
@define-color blue #6272a4;
@define-color purple #bd93f9;
@define-color pink #ff79c6;
@define-color white #ffffff;
@define-color brgreen #69ff94;
@define-color brcyan #a4ffff;
@define-color brblue #6272a4;
@define-color brpurple #d6acff;
@define-color brpink #ff92df;
@define-color arch_blue #89b4fa;
EOF

# ─── sway (title bars / tabs, borders) ───────────────────────────────────────
cat > "$HOME/.config/sway/theme.conf" <<EOF
# $header
# class                 border    backgr.   text        indic.      child_border
client.focused          $ACCENT $ACCENT $ACCENT_FG $ACCENT_FG $ACCENT
client.focused_inactive $UI_BG $UI_BG $UI_FG $UI_BG $UI_BG
client.unfocused        $UI_BG $UI_BG $FADE $UI_BG $UI_BG
client.urgent           $URGENT $URGENT $URGENT_FG $URGENT $URGENT
EOF

# ─── tmux (layout lives in ~/.tmux.conf, it only reads these) ────────────────
cat > "$HOME/.config/tmux/theme.conf" <<EOF
# $header
set -g @wb_bg        "$UI_BG"
set -g @wb_fg        "$UI_FG"
set -g @wb_accent    "$ACCENT"
set -g @wb_accent_fg "$ACCENT_FG"
set -g @wb_fade      "$FADE"
set -g @wb_warn      "$WARN"
set -g @wb_warn_fg   "$WARN_FG"

set -g status-style "bg=default,fg=$UI_FG"
set -g pane-border-style "fg=$UI_BG"
set -g pane-active-border-style "fg=$ACCENT,bold"
set -g message-style "fg=$UI_FG,bg=$UI_BG"
set -g message-command-style "fg=$ACCENT_FG,bg=$ACCENT"
set -g mode-style "fg=$WARN_FG,bg=$ACCENT"
set -g display-panes-active-colour "$ACCENT"
set -g display-panes-colour "$UI_BG"
set -g clock-mode-colour "$ACCENT"
EOF

# ─── foot ────────────────────────────────────────────────────────────────────
{
  echo "# $header"
  echo "[colors]"
  echo "background=${TERM_BG#\#}"
  echo "alpha=$TERM_ALPHA"
  echo "foreground=${TERM_FG#\#}"
  for i in "${!ANSI[@]}"; do
    if (( i < 8 )); then echo "regular$i=${ANSI[i]#\#}"; else echo "bright$((i-8))=${ANSI[i]#\#}"; fi
  done
} > "$HOME/.config/foot/colors.ini"

# ─── wofi ────────────────────────────────────────────────────────────────────
cat > "$HOME/.config/wofi/style.css" <<EOF
/* $header */
window {
  margin: 0px;
  border: 5px solid $ACCENT;
  background-color: $MENU_BG;
}

#input {
  margin: 10px;
  border: none;
  color: $MENU_FG;
  background-color: $MENU_BG;
}

#inner-box, #outer-box {
  margin: 10px;
  border: none;
  background-color: $MENU_BG;
}

#scroll {
  margin: 1px;
  border: none;
}

#text {
  margin: 10px;
  border: none;
  color: $MENU_FG;
}

#entry:selected {
  background-color: $UI_BG;
}

#entry:selected #text {
  color: $UI_FG;
}

* {
  font-size: 20px;
}
EOF

# ─── zsh: p10k prompt, syntax highlighting, ls colours ───────────────────────
# Sourced by ~/.zshrc after ~/.p10k.zsh; running shells re-read it at the next prompt.
rgb() { printf '%d;%d;%d' "0x${1:1:2}" "0x${1:3:2}" "0x${1:5:2}"; }
cat > "$HOME/.config/zsh/theme.zsh" <<EOF
# $header
typeset -g POWERLEVEL9K_OS_ICON_FOREGROUND='$UI_FG'
typeset -g POWERLEVEL9K_OS_ICON_BACKGROUND='$UI_BG2'
typeset -g POWERLEVEL9K_DIR_{,SHORTENED_,ANCHOR_}FOREGROUND='$UI_FG'
typeset -g POWERLEVEL9K_DIR_BACKGROUND='$UI_BG'
typeset -g POWERLEVEL9K_STATUS_{OK,OK_PIPE,ERROR,ERROR_SIGNAL,ERROR_PIPE}_FOREGROUND='$UI_FG'
typeset -g POWERLEVEL9K_STATUS_{OK,OK_PIPE,ERROR,ERROR_SIGNAL,ERROR_PIPE}_BACKGROUND='$UI_BG2'
typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME{,_PREFIX}_FOREGROUND='$UI_FG'
typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME{,_PREFIX}_BACKGROUND='$UI_BG2'
typeset -g POWERLEVEL9K_TIME_FOREGROUND='$UI_FG'
typeset -g POWERLEVEL9K_TIME_BACKGROUND='$UI_BG'

typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[arg0]='fg=$CMD_FG,bold'
ZSH_HIGHLIGHT_STYLES[argument]='fg=$CMD_FG,bold'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=$CMD_FG,bold'
ZSH_HIGHLIGHT_STYLES[sudo]='fg=$CMD_FG,bold'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=$ACCENT,bold'

export LS_COLORS='di=1;38;2;$(rgb "$ACCENT"):fi=1;38;2;$(rgb "$TERM_FG"):'
EOF

# ─── yazi: palette laid over a flavor (theme.toml wins over flavor.toml) ─────
# yazi picks dark/light by the terminal background; the palette sets the matching one
if is_light; then yazi_dark=claude-inspired yazi_light=${yazi_flavor:-catppuccin-latte}
else yazi_dark=${yazi_flavor:-claude-inspired} yazi_light=catppuccin-latte; fi
for f in "$yazi_dark" "$yazi_light"; do
  [[ -d $HOME/.config/yazi/flavors/$f.yazi ]] || die "$name: yazi flavor '$f' not installed"
done
cat > "$HOME/.config/yazi/theme.toml" <<EOF
# $header
[flavor]
dark  = "$yazi_dark"
light = "$yazi_light"

[app]
overall = { bg = "$( (( translucent )) && echo reset || echo "$TERM_BG")" }

[mgr]
cwd             = { fg = "$ACCENT" }
hovered         = { fg = "$ACCENT_FG", bg = "$ACCENT", bold = true }
find_keyword    = { fg = "$ACCENT_FG", bg = "$ACCENT", bold = true }
marker_selected = { fg = "$ACCENT", bg = "$ACCENT" }
count_selected  = { fg = "$ACCENT_FG", bg = "$ACCENT" }
border_style    = { fg = "$UI_BG" }

[indicator]
current = { fg = "$ACCENT_FG", bg = "$ACCENT", bold = true }
parent  = { fg = "$UI_FG", bg = "$UI_BG", bold = true }
preview = { fg = "$UI_FG", bg = "$UI_BG", underline = true }

[mode]
normal_main = { fg = "$ACCENT_FG", bg = "$ACCENT", bold = true }
normal_alt  = { fg = "$UI_FG", bg = "$UI_BG" }

[tabs]
active   = { fg = "$ACCENT_FG", bg = "$ACCENT", bold = true }
inactive = { fg = "$FADE", bg = "$UI_BG" }

[status]
progress_normal = { fg = "$ACCENT", bg = "$UI_BG2" }
perm_type       = { fg = "$ACCENT" }

# replaces the flavor's rules: dirs = accent, plain files = text, special kinds = palette hues
[filetype]
rules = [
  { url = "*/", fg = "$ACCENT", bold = true },
  { mime = "image/*", fg = "$H_MAGENTA" },
  { mime = "{video,audio}/*", fg = "$H_CYAN" },
  { mime = "application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio}", fg = "$H_RED" },
  { mime = "application/{pdf,doc,rtf}", fg = "$H_YELLOW" },
  { url = "*", is = "exec", fg = "$H_GREEN" },
  { url = "*", is = "orphan", bg = "$URGENT" },
  { url = "*", fg = "$TERM_FG" },
]
EOF

# icons: each built-in icon keeps its glyph; its original devicons colour is mapped by hue
# onto the palette's HUES (greys -> text / dimmed text). The flavor's own icons are dropped.
grep -q '^# v2 ' "$YAZI_ICONS" 2>/dev/null || extract_yazi_icons
awk -F'\t' -v dir="$ACCENT" -v txt="$TERM_FG" -v dim="$(mix "$TERM_BG" "$TERM_FG" 60)" \
    -v urgent="$URGENT" -v hues="${HUES[*]}" '
  function hex(s) { return index("0123456789abcdef", tolower(s)) - 1 }
  function byte(c, i) { return hex(substr(c, i, 1)) * 16 + hex(substr(c, i + 1, 1)) }
  function pick(c,   r, g, b, mx, mn, d, h) {
    r = byte(c, 2); g = byte(c, 4); b = byte(c, 6)
    mx = r > g ? (r > b ? r : b) : (g > b ? g : b)
    mn = r < g ? (r < b ? r : b) : (g < b ? g : b)
    d = mx - mn
    if (mx == 0 || d / mx < 0.2) return mx >= 190 ? txt : dim     # grey / white
    if (mx == r)      h = 60 * (((g - b) / d) % 6)
    else if (mx == g) h = 60 * ((b - r) / d + 2)
    else              h = 60 * ((r - g) / d + 4)
    if (h < 0) h += 360
    return h < 15 || h >= 340 ? H[1] : h < 40 ? H[2] : h < 70 ? H[3] : h < 160 ? H[4] : \
           h < 200 ? H[5] : h < 260 ? H[6] : H[7]
  }
  BEGIN {
    split(hues, H, " ")
    print "\n[icon]\nprepend_conds = []\nprepend_exts = []\nprepend_files = []\nprepend_dirs = []\nglobs = []"
  }
  /^#/ { next }
  /^\[/ { if (sec) print "]"; sec = substr($0, 2, length($0) - 2); print sec " = ["; next }
  {
    key = "name"; fg = pick($3)
    if (sec == "conds") {
      key = "if"
      fg = ($1 ~ /^dir/) ? dir : ($1 == "exec") ? H[4] : ($1 ~ /orphan|dummy/) ? urgent : \
           ($1 == "link") ? H[5] : ($1 == "!dir") ? txt : H[3]
    }
    printf "  { %s = \"%s\", text = \"%s\", fg = \"%s\" },\n", key, $1, $2, fg
  }
  END { print "]" }
' "$YAZI_ICONS" >> "$HOME/.config/yazi/theme.toml"

# ─── nvim: catppuccin with the palette as color_overrides ────────────────────
# Read by the catppuccin spec in ~/.config/nvim/init.lua (ThemeReload()).
if is_light; then nv_flavour=latte nv_bg=light; else nv_flavour=mocha nv_bg=dark; fi
{
  echo "-- $header"
  echo "return {"
  echo "  flavour = \"$nv_flavour\","
  echo "  transparent = $( (( translucent )) && echo true || echo false ),"
  echo "  background = \"$nv_bg\","
  echo "  overrides = {"
  if (( ! NVIM_NATIVE )); then
    m() { echo "    $1 = \"$2\","; }
    m base "$TERM_BG";  m mantle "$(mix "$TERM_BG" "$UI_BG2" 12)";  m crust "$(mix "$TERM_BG" "$UI_BG2" 6)"
    m surface0 "$(mix "$TERM_BG" "$UI_BG" 30)"; m surface1 "$(mix "$TERM_BG" "$UI_BG" 55)"
    m surface2 "$(mix "$TERM_BG" "$UI_BG" 80)"
    m overlay0 "$(mix "$TERM_BG" "$TERM_FG" 40)"; m overlay1 "$(mix "$TERM_BG" "$TERM_FG" 50)"
    m overlay2 "$(mix "$TERM_BG" "$TERM_FG" 60)"
    m subtext0 "$(mix "$TERM_BG" "$TERM_FG" 75)"; m subtext1 "$(mix "$TERM_BG" "$TERM_FG" 88)"
    m text "$TERM_FG";  m mauve "$ACCENT";  m blue "$CMD_FG";  m lavender "$(mix "$CMD_FG" "$TERM_FG" 50)"
    if (( ${#ANSI[@]} )); then
      m red "${ANSI[9]}";  m maroon "${ANSI[1]}";  m peach "${ANSI[3]}";  m yellow "${ANSI[11]}"
      m green "${ANSI[10]}";  m teal "${ANSI[14]}";  m sky "${ANSI[6]}";  m sapphire "${ANSI[4]}"
      m pink "${ANSI[13]}";  m flamingo "${ANSI[5]}";  m rosewater "${ANSI[15]}"
    fi
  fi
  echo "  },"
  echo "}"
} > "$HOME/.config/nvim/lua/theme_colors.lua"

# ─── kitty wallpaper panel (`wallpaper`) ─────────────────────────────────────
# color0 = background: asciiquarium and cmatrix paint on "black". Palettes without ANSI
# get their terminal colours from HUES.
if (( ${#ANSI[@]} )); then wp=("${ANSI[@]}")
else
  wp=("$TERM_BG" "$H_RED" "$H_GREEN" "$H_YELLOW" "$H_BLUE" "$H_MAGENTA" "$H_CYAN" "$TERM_FG"
      "$(mix "$TERM_BG" "$TERM_FG" 40)" "$H_RED" "$H_GREEN" "$H_YELLOW" "$H_BLUE" "$H_MAGENTA" "$H_CYAN" "$TERM_FG")
fi
wp[0]=$TERM_BG
{
  echo "# $header"
  echo "font_family MesloLGS NF"
  echo "font_size 18"          # bigger art = fewer cells = less CPU (asciiquarium: 25 % -> 14 %)
  echo "background $TERM_BG"
  echo "foreground $TERM_FG"
  echo "cursor $TERM_BG"
  echo "cursor_blink_interval 0"
  echo "window_padding_width 0"
  echo "enable_audio_bell no"
  echo "confirm_os_window_close 0"
  echo "sync_to_monitor yes"
  for i in "${!wp[@]}"; do echo "color$i ${wp[i]}"; done
} > "$HOME/.config/kitty/wallpaper.conf"

# scenes for `wallpaper theme`
if (( ! ${#WALLPAPERS[@]} )); then
  if is_light; then WALLPAPERS=(forest aquarium bonsai); else WALLPAPERS=(night aquarium bonsai); fi
fi
echo "${WALLPAPERS[*]}" > "$THEMES/current-wallpapers"

echo "$name" > "$CURRENT_FILE"

# ─── Reload what is running ──────────────────────────────────────────────────
# waybar: sway starts it (`swaybar_command waybar`) and replaces it on every reload, which
# also loads the new colours. Not SIGUSR2 (waybar 0.9 can crash on it), and no
# `swaymsg exec waybar`: sway does not manage such a bar, so the next reload adds a second.
# Strays from earlier versions of this script go first.
if pgrep -x waybar >/dev/null; then
  pkill -x waybar
  for _ in {1..20}; do pgrep -x waybar >/dev/null || break; sleep 0.1; done
fi
swaymsg reload >/dev/null 2>&1 || true
for sock in "${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)"/*; do
  [[ -S $sock ]] && tmux -S "$sock" source-file "$HOME/.config/tmux/theme.conf" 2>/dev/null || true
done

for sock in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/nvim.*.0; do   # running nvim instances
  [[ -S $sock ]] && timeout 2 nvim --server "$sock" \
    --remote-expr 'execute("lua if ThemeReload then ThemeReload() end")' >/dev/null 2>&1 || true
done

[[ -x $HOME/.local/bin/wallpaper ]] && "$HOME/.local/bin/wallpaper" reload >/dev/null 2>&1 || true

echo "theme: $name applied (new foot windows and yazi pick up the new colours)"
